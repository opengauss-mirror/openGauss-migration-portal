#!/bin/bash

# Copyright (c) Huawei Technologies Co., Ltd. 2025-2025. All rights reserved.
# Description: Migration Tool Installation Script

set -euo pipefail

usage() {
    cat <<EOF
Migration Tool Installation Script

Usage:
  Basic Usage:
    $0 tools                           Install all migration tools

    $0 chameleon                       Install MySQL full migration tool
    $0 full_replicate                  Install PostgreSQL full migration tool
    $0 milvus_migration_tool           Install Milvus full migration tool
    $0 elasticsearch_migration_tool    Install Elasticsearch full migration tool
    $0 debezium                        Install incremental and reverse migration tool
    $0 data_checker                    Install data check migration tool
    $0 kafka                           Install confluent

    $0 [chameleon | full_replicate | milvus_migration_tool | elasticsearch_migration_tool | debezium | data_checker | kafka]
                                       Install specified migration tools

    $0 dependencies                    Install chameleon dependencies

    $0 check                           Check all migration tools install status

    $0 -h|--help                       Show this help message

  Force Install:
    $0 dependencies -f|--force         Force install tools dependencies

  Examples:
    $0 full_replicate debezium kafka                Install all PostgreSQL migration tools
    $0 chameleon data_checker debezium kafka        Install all MySQL migration tools

Tips:
  1. Force install tools dependencies, the rpm packages may not match the system architecture of the server. Please confirm the system architecture of the current portal installation package before selecting.
  2. Requires Java 17 or later to be installed.
EOF
    exit 1
}

# Check if the script is run as root
if [ "$(id -u)" -eq 0 ]; then
    echo "Error: This script must not be run as root. Please switch to a regular user and try again." >&2
    exit 1
fi

# Check if the first argument is provided
if [ $# -eq 0 ]; then
    usage
fi

# Check for help argument
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
fi

# Function to check Java version
check_java_version() {
    local java_version
    local version_num

    if ! java_version=$(java -version 2>&1 | awk -F '"' '/version/ {print $2}'); then
        echo "Error: Java is not installed or not in PATH"
        return 1
    fi

    if [[ "$java_version" =~ ^1\. ]]; then
        version_num=$(echo "$java_version" | cut -d. -f2)
    else
        version_num=$(echo "$java_version" | cut -d. -f1)
    fi

    if [ "$version_num" -lt 17 ]; then
        echo "Error: Java 17 or later is required (found Java $java_version)"
        return 1
    fi
    return 0
}

# Verify Java is available and version >= 17
if ! check_java_version; then
    exit 1
fi

# handle commands: tools/check (no parameters)
if [[ "$1" == "tools" || "$1" == "check" ]]; then
    COMPONENT="$1"
    shift
    if [ $# -gt 0 ]; then
        echo "Error: Unknown parameter '$1' for '$COMPONENT'"
        usage
    fi
    ARGS=("--install" "$COMPONENT")
# handle command: dependencies (supports -f/--force)
elif [[ "$1" == "dependencies" ]]; then
    COMPONENT="dependencies"
    shift
    ARGS=("--install" "$COMPONENT")
    if [ $# -gt 0 ]; then
        if [[ "$1" == "-f" || "$1" == "--force" ]]; then
            ARGS+=("--force")
            shift
        else
            echo "Error: Unknown parameter '$1' for dependencies install"
            usage
        fi
    fi
    if [ $# -gt 0 ]; then
        echo "Error: Too many parameters for dependencies install"
        usage
    fi
# handle commands: tools list (supports multiple tools parameters)
else
    TOOLS=("$@")
    # verify all tools name valid
    for tool in "${TOOLS[@]}"; do
        case "$tool" in
            chameleon|full_replicate|milvus_migration_tool|elasticsearch_migration_tool|debezium|data_checker|kafka)
                ;;
            *)
                echo "Error: Invalid tool name '$tool'"
                usage
                ;;
        esac
    done
    ARGS=("--install" "${TOOLS[@]}")
fi

# Change to project root
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")
cd "$PROJECT_ROOT" || {
    echo "Error: Failed to change to project directory"
    exit 1
}

# Find the JAR file
JAVA_PROGRAM=$(ls openGauss-portal-*.jar 2> /dev/null | head -n 1)
if [[ -z "$JAVA_PROGRAM" ]]; then
    echo "Error: No openGauss-portal-*.jar file found in $PROJECT_ROOT"
    exit 1
fi

if [[ "${ARGS[*]}" =~ "--force" ]]; then
    echo "Warning: Force mode enabled"
fi

# Execute Java program
exec java -Dfile.encoding=UTF-8 -jar "$JAVA_PROGRAM" "${ARGS[@]}"